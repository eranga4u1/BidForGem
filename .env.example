# ---------------------------------------------------------------------------
# Gem / BidForGem — example environment
#
# Copy to `.env` and fill in. NEVER commit a real `.env` (it is gitignored).
# All values here are PLACEHOLDERS — no real secrets.
#
# How env is loaded:
#   - The API reads from the PROCESS environment (there is no dotenv autoload).
#     Export these in your shell, or use a loader (direnv / `dotenv -e .env --`)
#     / your host's env settings.
#   - The web app (Next.js) autoloads `apps/web/.env.local` for the
#     NEXT_PUBLIC_* vars — put those there (or in the shell) for the web build.
#   - For pure local dev you can start with almost nothing: `dev:api` boots an
#     ephemeral embedded Postgres and injects a throwaway JWT secret if unset.
# ---------------------------------------------------------------------------

# === Database ===============================================================
# Required in real deployments. If unset, `pnpm --filter @gem/api dev:api`
# starts a throwaway embedded Postgres (data is lost on restart) — fine for
# local dev, never for production.
DATABASE_URL=postgres://gem:gem@localhost:5432/gem

# === Auth / JWT =============================================================
# Required. >= 32 chars, high entropy. Signs stateless access tokens.
# (dev runners inject an INSECURE throwaway secret if unset — never rely on it.)
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Optional. JWT `iss` claim. Default: gem-api
JWT_ISSUER=gem-api
# Optional. Access-token lifetime, seconds. Default: 900 (15 min)
ACCESS_TOKEN_TTL_SECONDS=900
# Optional. Refresh-token lifetime, seconds. Default: 2592000 (30 days)
REFRESH_TOKEN_TTL_SECONDS=2592000
# Optional. Password-reset token lifetime, seconds. Default: 1800 (30 min)
PASSWORD_RESET_TTL_SECONDS=1800
# Optional. argon2id parameters. Defaults: 19456 / 2 / 1
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# === Email (transactional) ==================================================
# Optional. Off by default. When true, EMAIL_API_KEY MUST be set (fails fast at
# boot otherwise). When false, a log-only provider records intended sends and
# nothing hits the network.
EMAIL_ENABLED=false
# Required only when EMAIL_ENABLED=true. Resend API key.
EMAIL_API_KEY=re_replace_with_your_resend_api_key
# Optional. Verified sender identity. Default: Gem <no-reply@gem.local>
EMAIL_FROM=Gem <no-reply@example.com>
# Optional. Base URL used to build links inside emails (e.g. password reset).
# Default: http://localhost:3000
APP_BASE_URL=http://localhost:3000

# === Storage (gem media) ====================================================
# Optional. One of:
#   local  — dev only; bytes held in the API process memory, served over HTTP
#            (lost on restart). `dev:api` defaults to this.
#   s3     — S3-compatible object storage (AWS S3 or Cloudflare R2).
#   (unset/other) — an in-memory fake (used by tests).
STORAGE_DRIVER=local
# Optional. Base URL the `local` provider uses to build object URLs.
# Default: http://localhost:4000
PUBLIC_API_URL=http://localhost:4000
# --- S3 / R2 (only when STORAGE_DRIVER=s3) ---
# Optional. Set for Cloudflare R2 or non-AWS S3, e.g.
# https://<accountid>.r2.cloudflarestorage.com  (omit for AWS S3)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Optional. Default: auto  (R2 uses "auto")
S3_REGION=auto
# Required when STORAGE_DRIVER=s3.
S3_ACCESS_KEY_ID=replace-with-your-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
# Optional. Bucket names. Defaults: gem-public / gem-private
S3_PUBLIC_BUCKET=gem-public
S3_PRIVATE_BUCKET=gem-private
# Required when STORAGE_DRIVER=s3. Public base URL that serves the public bucket
# (e.g. the R2 public bucket URL or its custom domain).
S3_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
# Optional. Addressing style. Default false (virtual-hosted). Set true only if
# R2 presigned URLs fail with a host/DNS error.
S3_FORCE_PATH_STYLE=false

# === Realtime / HTTP / CORS =================================================
# Optional. API HTTP + Socket.IO port. Default: 4000
PORT=4000
# Optional. Comma-separated allowed CORS origins. Default: http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# --- Web (Next.js) public vars — put these in apps/web/.env.local ---
# Optional. API base URL the browser calls. Default: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional. Socket.IO URL. Default: same as NEXT_PUBLIC_API_URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# === Auction close scheduler ================================================
# Optional. Off by default. Set "true" to run the server-side poller that
# closes due auctions (required for auctions to close on time).
AUCTION_SCHEDULER_ENABLED=false
# Optional. Poll interval, ms. Default: 10000
AUCTION_CLOSE_INTERVAL_MS=10000
# Optional. Max auctions closed per tick. Default: 50
AUCTION_CLOSE_BATCH_SIZE=50

# === Settings cache =========================================================
# Optional. TTL (ms) for the cached app_settings (e.g. posting-fee config).
# Default: 60000
SETTINGS_CACHE_TTL_MS=60000
