{
  "name": "@gem/api",
  "version": "0.0.0",
  "private": true,
  "description": "Gem platform API — persistence (Drizzle) and framework-free domain logic.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "seed": "tsx src/db/seed.ts",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@gem/types": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@gem/config": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^10.7.0",
    "pg": "^8.22.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
