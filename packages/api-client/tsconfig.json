{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@gem/config/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    // This package targets web and React Native, so fetch/Response/AbortSignal
    // come from the DOM lib (available in both browsers and RN) rather than
    // @types/node. Keeps the client platform-agnostic.
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
